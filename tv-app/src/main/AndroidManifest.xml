<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV-only app: no touchscreen; leanback marks it as an Android TV app. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- The menu's Exit starts the stock launcher by name; API 30+ only lists home apps declared here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
      enableOnBackInvokedCallback=false: with targetSdk 36+ on Android 16+, predictive back stops delivering
      KEYCODE_BACK and Back would finish the activity. Back is a scoreboard key here (undo / menu). Older
      platforms ignore the attribute, which is fine: they always deliver KEYCODE_BACK.
    -->
    <application
        android:name=".TableroApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Tablero"
        tools:ignore="UnusedAttribute">

        <!--
          A home app (docs/stick-setup.md): made the default, the stick boots into the scoreboard and HOME always
          returns to it. singleTask, like launchers, so HOME brings back the running activity instead of a new one.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
