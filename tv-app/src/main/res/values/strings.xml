<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">tablero</string>

    <!-- Teams: home plays on the left, away on the right. Uppercased on the scoreboard. -->
    <string name="team_home">Home</string>
    <string name="team_away">Away</string>

    <!-- Status bar. -->
    <string name="status_clock_running">CLOCK RUNNING</string>
    <string name="status_clock_stopped">CLOCK STOPPED</string>

    <!-- Action confirmation over the status bar. %1$s is the team name, %2$s the change (+3, −1). -->
    <string name="feedback_score">%1$s %2$s</string>
    <!-- %1$s says what was undone: a score change (HOME +1) or one of the actions below. -->
    <string name="feedback_undone">UNDONE · %1$s</string>
    <string name="feedback_nothing_to_undo">NOTHING TO UNDO</string>
    <string name="feedback_plus" translatable="false">+%1$d</string>
    <string name="feedback_minus" translatable="false">−%1$d</string>
    <string name="feedback_score_change" translatable="false">%1$d → %2$d</string>
    <string name="undone_start_clock">START CLOCK</string>
    <string name="undone_stop_clock">STOP CLOCK</string>
    <string name="undone_adjust_clock">ADJUST CLOCK</string>
    <string name="undone_set_clock">SET GAME CLOCK</string>
    <string name="undone_reset_clock">RESET CLOCK</string>
    <string name="undone_new_game">NEW GAME</string>
    <string name="undone_game_length">GAME LENGTH</string>

    <!-- Time-up bar over the status bar. The result is in sentence case: %1$s is the winning team (Home, Away),
         %2$d its score and %3$d the other team's; a tie gives both scores. -->
    <string name="time_up_title">TIME UP</string>
    <string name="time_up_wins">%1$s wins %2$d–%3$d</string>
    <string name="time_up_tie">Tie %1$d–%2$d</string>
    <string name="time_up_new_game">NEW GAME</string>
    <string name="time_up_reset_clock">RESET CLOCK · KEEP SCORE</string>

    <!-- Key hints: the remote key's label in a keycap, then what it does. -->
    <string name="key_back">BACK</string>
    <string name="hint_undo">UNDO</string>

    <!-- Quick clock adjust (↓): bar over the status bar. %1$s is the clock when the overlay opened. -->
    <string name="adjust_title">ADJUST CLOCK</string>
    <string name="adjust_was">was %1$s</string>
    <string name="adjust_plus" translatable="false">+%1$s</string>
    <string name="adjust_minus" translatable="false">−%1$s</string>
    <string name="key_up_down" translatable="false">↑ ↓</string>
    <string name="key_left_right" translatable="false">← →</string>
    <string name="key_ok" translatable="false">OK</string>
    <string name="hint_minute">±1 MIN</string>
    <string name="hint_second">±1 SEC</string>
    <string name="hint_done">DONE</string>
    <!-- Uppercase like every scoreboard label; not a dialog button. -->
    <string name="hint_cancel" tools:ignore="ButtonCase">CANCEL</string>

    <!-- Menu (Back long press): a panel of rows in sentence case. %1$s is the team name (Home, Away). -->
    <string name="menu_title">Menu</string>
    <string name="menu_game_clock">Game clock</string>
    <string name="menu_game_length">Game length</string>
    <string name="menu_score">%1$s score</string>
    <string name="menu_new_game">New game</string>
    <string name="menu_language">Language</string>
    <string name="menu_exit">Exit to Android TV</string>
    <string name="hint_move">MOVE</string>
    <string name="hint_change">CHANGE</string>
    <string name="hint_open">OPEN</string>
    <string name="hint_close">CLOSE</string>

    <!-- Set game clock dialog (menu → Game clock), only while the clock is stopped. %1$s is the clock before. -->
    <string name="set_clock_title">SET GAME CLOCK</string>
    <string name="set_clock_was">Was %1$s · clock stopped</string>
    <string name="set_clock_minutes">MIN</string>
    <string name="set_clock_seconds">SEC</string>
    <string name="hint_field">FIELD</string>
    <string name="hint_save">SAVE</string>

    <!-- Exit confirm (menu → Exit to Android TV), only while the clock is stopped. The body depends on whether HOME
         returns to the scoreboard (tablero is the default home app) or not. %1$d is how many seconds to hold OK. -->
    <string name="exit_eyebrow">ADMIN</string>
    <string name="exit_title">Exit to Android TV?</string>
    <string name="exit_body_home">Score and clock are saved. Press HOME on the remote to come back to the scoreboard.</string>
    <string name="exit_body_apps">Score and clock are saved. Open tablero from the apps row to come back to the scoreboard.</string>
    <string name="exit_cancel" tools:ignore="ButtonCase">CANCEL</string>
    <string name="exit_confirm" tools:ignore="ButtonCase">EXIT</string>
    <string name="exit_hold">HOLD OK · %1$d S</string>
</resources>
