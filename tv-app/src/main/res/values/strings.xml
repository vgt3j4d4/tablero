<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">tablero</string>

    <!-- Teams: home plays on the left, away on the right. Uppercased on the scoreboard. -->
    <string name="team_home">Home</string>
    <string name="team_away">Away</string>

    <!-- Status bar. -->
    <string name="status_clock_running">CLOCK RUNNING</string>
    <string name="status_clock_stopped">CLOCK STOPPED</string>

    <!-- Action confirmation over the status bar. %1$s is the team name, %2$s the change (+3, −1). -->
    <string name="feedback_score">%1$s %2$s</string>
    <!-- %1$s says what was undone: a score change (HOME +1) or one of the actions below. -->
    <string name="feedback_undone">UNDONE · %1$s</string>
    <string name="feedback_nothing_to_undo">NOTHING TO UNDO</string>
    <string name="feedback_plus" translatable="false">+%1$d</string>
    <string name="feedback_minus" translatable="false">−%1$d</string>
    <string name="feedback_score_change" translatable="false">%1$d → %2$d</string>
    <string name="undone_start_clock">START CLOCK</string>
    <string name="undone_stop_clock">STOP CLOCK</string>
    <string name="undone_adjust_clock">ADJUST CLOCK</string>
    <string name="undone_set_clock">SET GAME CLOCK</string>
    <string name="undone_reset_clock">RESET CLOCK</string>
    <string name="undone_new_game">NEW GAME</string>
    <string name="undone_game_length">GAME LENGTH</string>
    <string name="undone_possession">POSSESSION ARROW</string>
    <string name="undone_rules">RULES</string>
    <string name="undone_next_period">NEXT PERIOD</string>
    <string name="undone_end_break">END BREAK</string>
    <string name="undone_period">PERIOD</string>
    <!-- Under FIBA rules, after a foul (and as undone: UNDONE · AWAY FOUL). %1$s is the team name (HOME, AWAY). -->
    <string name="feedback_foul">%1$s FOUL</string>

    <!-- Possession arrow (↑): the label over the arrows between the scores, then its confirmations. %1$s is the team
         the arrow now points to (HOME, AWAY). -->
    <string name="possession_label">POS</string>
    <string name="feedback_possession">POS → %1$s</string>
    <string name="feedback_possession_hidden">POS HIDDEN</string>

    <!-- Under FIBA rules: the label over each team's fouls, beside the clock, and the label over the period between
         the scores, which reads OT in overtime. -->
    <string name="fouls_label">FOULS</string>
    <string name="period_label">PERIOD</string>
    <string name="overtime_label">OT</string>
    <!-- Team foul bar (hold ↓): the keys pick the team (← HOME, → AWAY). -->
    <string name="foul_title">TEAM FOUL</string>

    <!-- Time-up bar over the status bar. The result is in sentence case: %1$s is the winning team (Home, Away),
         %2$d its score and %3$d the other team's; a tie gives both scores. -->
    <string name="time_up_title">TIME UP</string>
    <string name="time_up_wins">%1$s wins %2$d–%3$d</string>
    <string name="time_up_tie">Tie %1$d–%2$d</string>
    <string name="time_up_new_game">NEW GAME</string>
    <string name="time_up_reset_clock">RESET CLOCK · KEEP SCORE</string>
    <!-- Under FIBA rules, at the end of a period (%1$d is the period, or the overtime): who leads, as in time_up_wins,
         and the break before the next period (%1$s is its length, 2:00) or straight on to it. -->
    <string name="time_up_period_end">END OF PERIOD %1$d</string>
    <string name="time_up_overtime_end">END OF OT %1$d</string>
    <string name="time_up_leads">%1$s leads %2$d–%3$d</string>
    <string name="time_up_break">BREAK · %1$s</string>
    <string name="time_up_halftime">HALFTIME · %1$s</string>
    <string name="time_up_skip_break">SKIP BREAK</string>

    <!-- Under FIBA rules, the bar over the status bar while a break counts down on the game clock: the break, then
         which period (%1$d) or overtime starts when it ends. The number names the period, it counts nothing. -->
    <string name="break_title">BREAK</string>
    <string name="break_halftime">HALFTIME</string>
    <string name="break_next_period" tools:ignore="PluralsCandidate">Period %1$d starts at 0:00</string>
    <string name="break_next_overtime" tools:ignore="PluralsCandidate">OT %1$d starts at 0:00</string>
    <string name="hint_adjust">ADJUST</string>
    <string name="hint_end_break">END BREAK</string>

    <!-- Key hints: the remote key's label in a keycap, then what it does. -->
    <string name="key_back">BACK</string>
    <string name="hint_undo">UNDO</string>

    <!-- Quick clock adjust (↓): bar over the status bar. %1$s is the clock when the overlay opened. -->
    <string name="adjust_title">ADJUST CLOCK</string>
    <string name="adjust_was">was %1$s</string>
    <string name="adjust_plus" translatable="false">+%1$s</string>
    <string name="adjust_minus" translatable="false">−%1$s</string>
    <string name="key_up_down" translatable="false">↑ ↓</string>
    <string name="key_left_right" translatable="false">← →</string>
    <string name="key_ok" translatable="false">OK</string>
    <string name="key_up" translatable="false">↑</string>
    <string name="key_down" translatable="false">↓</string>
    <string name="key_left" translatable="false">←</string>
    <string name="key_right" translatable="false">→</string>
    <string name="hint_minute">±1 MIN</string>
    <string name="hint_second">±1 SEC</string>
    <string name="hint_done">DONE</string>
    <!-- Uppercase like every scoreboard label; not a dialog button. -->
    <string name="hint_cancel" tools:ignore="ButtonCase">CANCEL</string>

    <!-- Menu (Back long press): a panel of rows in sentence case. %1$s is the team name (Home, Away). -->
    <string name="menu_title">Menu</string>
    <string name="menu_game_clock">Game clock</string>
    <string name="menu_game_length">Game length</string>
    <string name="menu_score">%1$s score</string>
    <string name="menu_new_game">New game</string>
    <!-- Under FIBA rules: the period (%1$d is the overtime in overtime), its length, and %1$s is the team name. -->
    <string name="menu_period">Period</string>
    <string name="menu_period_overtime">OT %1$d</string>
    <string name="menu_period_length">Period length</string>
    <string name="menu_fouls">%1$s fouls</string>
    <string name="menu_rules">Rules</string>
    <!-- Menu → Rules values: back-to-back games on one clock, and FIBA's periods, fouls, breaks and overtime. -->
    <string name="rules_pickup">Pickup</string>
    <string name="rules_fiba" translatable="false">FIBA</string>
    <string name="menu_layout">Layout</string>
    <!-- Menu → Layout values: today's board, and the one with bigger digits for small screens. -->
    <string name="layout_classic">Classic</string>
    <string name="layout_large">Large</string>
    <string name="menu_mode">Mode</string>
    <!-- Menu → Mode values: today's dark board, and a light one for daylight courts. -->
    <string name="mode_indoor">Indoor</string>
    <string name="mode_outdoor">Outdoor</string>
    <string name="menu_language">Language</string>
    <string name="menu_help">How to use</string>
    <string name="menu_exit">Exit</string>
    <string name="hint_move">MOVE</string>
    <string name="hint_change">CHANGE</string>
    <string name="hint_open">OPEN</string>
    <string name="hint_close">CLOSE</string>

    <!-- Set game clock dialog (menu → Game clock), only while the clock is stopped. %1$s is the clock before. -->
    <string name="set_clock_title">SET GAME CLOCK</string>
    <string name="set_clock_was">Was %1$s · clock stopped</string>
    <string name="set_clock_minutes">MIN</string>
    <string name="set_clock_seconds">SEC</string>
    <string name="hint_field">FIELD</string>
    <string name="hint_save">SAVE</string>

    <!-- Exit confirm (menu → Exit), only while the clock is stopped. The body depends on whether HOME
         returns to the scoreboard (tablero is the default home app) or not. %1$d is how many seconds to hold OK. -->
    <string name="exit_eyebrow">ADMIN</string>
    <string name="exit_title">Exit the scoreboard?</string>
    <string name="exit_body_home">Score and clock are saved. Press HOME on the remote to come back to the scoreboard.</string>
    <string name="exit_body_apps">Score and clock are saved. Open tablero from the apps row to come back to the scoreboard.</string>
    <string name="exit_cancel" tools:ignore="ButtonCase">CANCEL</string>
    <string name="exit_confirm" tools:ignore="ButtonCase">EXIT</string>
    <string name="exit_hold">HOLD OK · %1$d S</string>

    <!-- How to use (menu → How to use, and once on the first launch): a generic remote and what each key does when
         pressed or held. Row texts are in sentence case; %1$s is the team name (Home, Away), uppercased in the
         possession note. The legend's %1$s is the BACK key label, %2$s the menu row (How to use). -->
    <string name="help_eyebrow">HOW TO USE</string>
    <string name="help_title">Remote control</string>
    <string name="help_column_key">KEY</string>
    <string name="help_column_press">PRESS</string>
    <string name="help_column_hold">HOLD</string>
    <string name="help_clock">Start / stop clock</string>
    <string name="help_clock_note">The center button</string>
    <string name="help_score_up">%1$s +1</string>
    <string name="help_score_down">%1$s −1</string>
    <string name="help_score_note">Press twice for 2 points, three times for 3</string>
    <string name="help_possession">Flip possession arrow</string>
    <string name="help_possession_note">The first press points to %1$s</string>
    <string name="help_possession_hide">Hide arrow</string>
    <string name="help_adjust">Adjust clock</string>
    <string name="help_adjust_note">Works while the clock runs</string>
    <!-- Under FIBA rules: ↓ also adjusts a break, and holding it gives a team foul; %1$s / %2$s are Home / Away. -->
    <string name="help_adjust_note_breaks">Works while the clock runs, and in breaks</string>
    <string name="help_foul">Team foul</string>
    <string name="help_foul_note">Then ← %1$s or → %2$s</string>
    <string name="help_undo">Undo last action</string>
    <string name="help_undo_note">Fixes mistakes, even a new game</string>
    <string name="help_menu">Open menu</string>
    <string name="help_none" translatable="false">—</string>
    <string name="help_legend">Grey keys aren\'t used. To see this again: Menu (hold %1$s) → %2$s.</string>
    <string name="help_remote">Your remote may look different</string>
    <string name="key_home">HOME</string>
</resources>
