<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder Android TV launcher banner: an LED-style clock bar over two score bars, no text. 320×180 is the
  required banner size (VectorRaster only matters below API 21).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180"
    tools:ignore="VectorRaster">
    <path
        android:fillColor="@color/board_background"
        android:pathData="M0,0h320v180h-320z" />
    <path
        android:fillColor="@color/led_red"
        android:pathData="M80,30h160v50h-160z" />
    <path
        android:fillColor="@color/led_amber"
        android:pathData="M40,105h80v45h-80z M200,105h80v45h-80z" />
</vector>
